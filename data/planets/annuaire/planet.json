{
  "id": "annuaire",
  "version": 1,
  "simule": true,
  "label": "Bibliothèque publique",
  "lieu_ville": "Bibliothèque publique",
  "description": "Une bibliothèque de quartier tient un annuaire des commerces de proximité : nom, ville, adresse professionnelle et canaux génériques de la boutique. Ouvert dès le départ.",
  "source": "annuaire",
  "source_type": "annuaire_commerces",
  "scope": "B2B",
  "operations_autorisees": [
    {
      "id": "search",
      "description": "Recherche par filtres structurés ; renvoie des enregistrements du corpus, jamais d'invention ; peut ne rien trouver.",
      "filtres": [
        {
          "name": "ville",
          "type": "string",
          "match": "exact_insensible"
        },
        {
          "name": "secteur",
          "type": "string",
          "match": "exact_insensible"
        },
        {
          "name": "statut",
          "type": "string",
          "match": "exact"
        },
        {
          "name": "effectif_tranche",
          "type": "string",
          "match": "exact"
        }
      ],
      "max_resultats": 15
    }
  ],
  "source_ref_field": "record_id",
  "champs_renvoyes": [
    {
      "name": "record_id",
      "type": "string",
      "personal_data": false,
      "max_chars": 120,
