{
  "id": "registre",
  "version": 1,
  "simule": true,
  "label": "Hôtel de ville",
  "lieu_ville": "Hôtel de ville",
  "description": "À l'hôtel de ville, le registre des entreprises donne la forme juridique, le secteur, la taille, la date de création et le statut. Se débloque quand l'annuaire a rapporté 3 prospects retenus.",
  "source": "registre",
  "source_type": "registre_entreprises",
  "scope": "B2B",
  "operations_autorisees": [
    {
      "id": "search",
      "description": "Recherche par filtres structurés ; renvoie des enregistrements du corpus, jamais d'invention ; peut ne rien trouver.",
      "filtres": [
        {
          "name": "ville",
          "type": "string",
          "match": "exact_insensible"
        },
        {
          "name": "region",
          "type": "string",
          "match": "exact_insensible"
        },
        {
          "name": "secteur_code",
          "type": "string",
          "match": "exact"
        },
        {
          "name": "effectif_tranche",
          "type": "string",
          "match": "exact"
        },
        {
          "name": "statut_actif",
          "type": "boolean",
          "match": "exact"
        }
      ],
      "max_resultats": 15
    }
  ],
