{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_response",
  "title": "Réponse structurée d'un agent métier (proposition P3 à valider par BE06)",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "needs_info"
      ]
    },
    "deliverable_text": {
      "type": "string"
    },
    "facts_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "fact",
          "source"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_info": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "question",
          "why"
        ]
      },
      "maxItems": 2
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "problem",
          "fix"
        ]
      }
    },
    "source_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "doc_id",
          "date",
          "claim"
        ]
      }
    },
    "computations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool_call_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "tool_call_id",
          "label",
          "value"
        ]
      }
    },
    "prospect_selection": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "entry_id",
          "reason"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "deliverable_text",
    "facts_used",
    "assumptions",
    "missing_info"
  ]
}
