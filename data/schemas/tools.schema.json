{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools",
  "title": "Registre des outils (liste blanche, exécutés côté serveur)",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "writer",
                "prospector",
                "researcher",
                "analyst",
                "qa",
                "lead",
                "scout"
              ]
            },
            "minItems": 1
          },
          "server_side": {
            "type": "boolean"
          },
          "deterministic": {
            "type": "boolean"
          },
          "writes_state": {
            "type": "boolean"
          },
          "parameters": {
            "type": "object"
          },
          "returns": {
            "type": "string",
            "minLength": 1
          },
          "test_vectors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "roles",
          "server_side",
          "deterministic",
          "writes_state",
          "parameters",
          "returns"
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "tools"
  ]
}
