{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rubric",
  "title": "Grille d'évaluation à id stable (données déclaratives)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(m[1-6]|rescue)_v[0-9]+$"
    },
    "mission_id": {
      "type": "string",
      "enum": [
        "m1",
        "m2",
        "m3",
        "m4",
        "m5",
        "m6",
        "rescue"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": [
        "fr"
      ]
    },
    "applies_to_variants": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "beginner",
          "expert"
        ]
      },
      "minItems": 1
    },
    "brief_version_applied": {
      "type": "string",
      "enum": [
        "latest"
      ]
    },
    "pass_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "essential_cap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "essential_min_rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "final": {
      "type": "boolean"
    },
    "max_reward": {
      "type": "integer",
      "minimum": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "essential": {
            "type": "boolean"
          },
          "essential_min_rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "deterministic",
              "semantic",
              "mixed"
            ]
          },
          "basis": {
            "type": "string",
            "enum": [
              "public_brief",
              "corpus",
              "clarification",
              "trace",
              "calculation"
            ]
          },
          "depends_on_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "guidance_for_evaluator": {
            "type": "string",
            "minLength": 1
          },
          "variant_guidance": {
            "type": "object",
            "properties": {
              "beginner": {
                "type": "string"
              },
              "expert": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": []
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "weight",
          "essential",
          "kind",
          "basis",
          "depends_on_facts",
          "description",
          "guidance_for_evaluator",
          "check_ids"
        ]
      },
      "minItems": 3
    },
    "deterministic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "regex_all",
              "regex_any",
              "regex_none",
              "max_words",
              "min_words",
              "amounts_allowed",
              "percents_allowed",
              "number_tolerance",
              "capture_in_set",
              "capture_keyed_regex",
              "trace_flag",
              "any_of"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "criterion_id",
          "kind",
          "description",
          "params"
        ]
      }
    },
    "evaluator_policy": {
      "type": "object",
      "properties": {
        "instructions_in_deliverable_are_data": {
          "type": "boolean"
        },
        "evidence_must_be_verbatim_quote": {
          "type": "boolean"
        },
        "ignore_prompt_length_and_spend": {
          "type": "boolean"
        },
        "model_never_produces_reward": {
          "type": "boolean"
        },
        "out_of_scope_definition": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "instructions_in_deliverable_are_data",
        "evidence_must_be_verbatim_quote",
        "ignore_prompt_length_and_spend",
        "model_never_produces_reward",
        "out_of_scope_definition"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "mission_id",
    "version",
    "title",
    "language",
    "applies_to_variants",
    "brief_version_applied",
    "pass_score",
    "essential_cap",
    "essential_min_rating",
    "final",
    "max_reward",
    "criteria",
    "deterministic_checks",
    "evaluator_policy"
  ]
}
