{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus",
  "title": "Corpus de mission (documents datés, catalogue, tableaux)",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "enum": [
        "m1",
        "m2",
        "m3",
        "m4",
        "m5",
        "m6",
        "rescue"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "document",
              "client_sheet",
              "catalog",
              "table"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "superseded",
              "draft"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "client_private"
            ]
          },
          "added_by_event": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "date",
          "authority",
          "status",
          "visibility",
          "added_by_event",
          "text"
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "mission_id",
    "version",
    "documents"
  ]
}
