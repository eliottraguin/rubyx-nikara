{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm_models",
  "title": "Modèles LLM par rôle",
  "type": "object",
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "comment": {"type": "string"},
    "available": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "default": {"type": "string", "minLength": 1},
    "roles": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
  },
  "required": ["version", "available", "default", "roles"],
  "additionalProperties": false
}
