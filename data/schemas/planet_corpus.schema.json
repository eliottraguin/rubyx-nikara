{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planet_corpus",
  "title": "Corpus fictif d'un lieu (Tutoriel)",
  "type": "object",
  "required": ["planet_id", "version", "simule", "date_reference", "records"],
  "properties": {
    "planet_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "simule": {"type": "boolean", "const": true},
    "date_reference": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "records": {
      "type": "array", "minItems": 30,
      "items": {
        "type": "object",
        "required": ["record_id", "entreprise", "collecte_le"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^(ann|reg)_\\d{3}$"},
          "entreprise": {"type": "string", "minLength": 1, "maxLength": 120},
          "collecte_le": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "secteur": {"type": "string", "maxLength": 80},
          "adresse_pro": {"type": "string", "maxLength": 200},
          "ville": {"type": "string", "maxLength": 80},
          "code_postal": {"type": "string", "maxLength": 10},
          "telephone_standard": {"type": "string", "maxLength": 30},
          "email_generique": {"type": "string", "maxLength": 120},
          "site_web": {"type": "string", "maxLength": 200},
          "statut": {"enum": ["ouvert", "ferme_definitivement"]},
          "effectif_tranche": {"type": "string", "maxLength": 40},
          "identifiant_registre": {"type": "string", "maxLength": 30},
          "forme_juridique": {"type": "string", "maxLength": 60},
          "secteur_libelle": {"type": "string", "maxLength": 120},
          "secteur_code": {"type": "string", "maxLength": 10},
          "date_creation": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "region": {"type": "string", "maxLength": 80},
          "statut_actif": {"type": "boolean"},
          "dirigeant_fonction": {"type": "string", "maxLength": 60}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
