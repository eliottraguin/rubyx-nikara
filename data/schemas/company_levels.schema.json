{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company_levels",
  "title": "Niveaux d'entreprise à trois objectifs (data/company/levels.json, remplace rules_v2.building.levels, ticket C6)",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "objectifs": {
            "type": "object",
            "properties": {
              "clients_min": {
                "type": "integer",
                "minimum": 0
              },
              "argent_min": {
                "type": "integer",
                "minimum": 0
              },
              "reputation_min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": ["clients_min", "argent_min", "reputation_min"],
            "additionalProperties": false
          },
          "apparence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["level", "objectifs", "apparence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "levels"],
  "additionalProperties": false
}
