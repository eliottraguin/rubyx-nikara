{
  "id": "carte-locale",
  "label": "Carte locale",
  "version": 1,
  "scope": "B2B",
  "required_fields": [
    "source_ref",
    "entreprise",
    "collecte_le"
  ],
  "allowed_fields": [
    {
      "name": "source_ref",
      "type": "string",
      "description": "Identifiant de l'enregistrement renvoyé pendant l'expédition (obligatoire, vérifié par code)",
      "personal_data": false,
      "max_chars": 120
    },
    {
      "name": "entreprise",
      "type": "string",
      "description": "Nom de l'entreprise",
      "personal_data": false,
      "max_chars": 120
    },
    {
      "name": "collecte_le",
      "type": "date",
      "description": "Date de collecte (UTC, ISO 8601), obligatoire",
      "personal_data": false
    },
    {
      "name": "categorie",
      "type": "string",
      "description": "Catégorie d'établissement",
      "personal_data": false,
      "max_chars": 80
    },
    {
      "name": "adresse_pro",
      "type": "string",
      "description": "Adresse de l'établissement",
      "personal_data": false,
      "max_chars": 200
    },
    {
      "name": "ville",
      "type": "string",
      "description": "Ville",
      "personal_data": false,
      "max_chars": 80
    },
    {
      "name": "horaires",
      "type": "string",
      "description": "Horaires d'ouverture",
      "personal_data": false,
      "max_chars": 200
    },
    {
      "name": "note_moyenne",
      "type": "number",
      "description": "Note moyenne agrégée",
      "personal_data": false
    },
    {
      "name": "nombre_avis",
      "type": "integer",
      "description": "Nombre d'avis (agrégat)",
      "personal_data": false
    },
    {
      "name": "telephone_standard",
      "type": "string",
      "description": "Téléphone de l'établissement",
      "personal_data": false,
      "max_chars": 30
    },
    {
      "name": "site_web",
      "type": "string",
      "description": "Site de l'établissement",
      "personal_data": false,
      "max_chars": 200
    }
  ],
  "always_excluded": [
    "date_naissance",
    "adresse_personnelle",
    "telephone_personnel",
    "email_personnel",
    "photo",
    "reseaux_personnels",
    "donnees_sensibles",
    "avis_texte_libre",
    "situation_familiale"
  ],
  "drop_unlisted_fields": true,
  "snapshot_max_chars": 2000,
  "notes": "Le texte des avis (écrit par des particuliers) n'est jamais conservé : seuls des agrégats le sont."
}
