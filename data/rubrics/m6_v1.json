  "criteria": [
    {
      "id": "facts_accuracy",
      "label": "Faits essentiels exacts",
      "weight": 20,
      "essential": true,
      "kind": "mixed",
      "basis": "corpus",
      "depends_on_facts": [],
      "description": "Tarif en vigueur (18,50 €) repris ; l'ancien prix du flyer n'est jamais présenté comme actuel.",
      "guidance_for_evaluator": "Pénalise toute présentation du prix du flyer comme tarif actuel.",
      "check_ids": [
        "price_current",
        "amounts_known"
      ]
    },
    {
      "id": "numeric_recommendation",
      "label": "Recommandation chiffrée exacte",
      "weight": 20,
      "essential": true,
      "kind": "deterministic",
      "basis": "calculation",
      "depends_on_facts": [],
      "description": "Taux et coût par acquisition par canal exacts, projection du nombre d'abonnements pour le budget (hypothèse signalée).",
      "guidance_for_evaluator": "Explique les calculs attendus.",
      "check_ids": [
        "pilot_values"
      ],
      "essential_min_rating": 0.8
    },
    {
      "id": "delivery",
      "label": "Contraintes de livraison",
      "weight": 15,
      "essential": false,
      "kind": "mixed",
      "basis": "public_brief",
      "depends_on_facts": [],
