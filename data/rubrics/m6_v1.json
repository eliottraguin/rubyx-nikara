  "deterministic_checks": [
    {
      "id": "price_current",
      "criterion_id": "facts_accuracy",
      "kind": "regex_all",
      "description": "Tarif 18,50 € mentionné.",
      "params": {
        "patterns": [
          "(?<![\\d,.])18[,.]50[\\s\\u00a0\\u202f]*(?:€|euros?)"
        ]
      }
    },
    {
      "id": "amounts_known",
      "criterion_id": "facts_accuracy",
      "kind": "amounts_allowed",
      "description": "Montants issus du corpus uniquement.",
      "params": {
        "allowed": [
          18.5,
          16,
          600,
          200,
          450,
          5,
          15
        ]
      }
    },
    {
      "id": "pilot_values",
      "criterion_id": "numeric_recommendation",
      "kind": "number_tolerance",
      "description": "Taux, CPA par canal et projection pour 600 €.",
      "params": {
        "targets": [
          {
            "label": "Newsletter taux",
            "line_pattern": "newsletter|lettre d.information",
            "unit_regex": "%",
            "expected": 5.0,
            "tolerance": 0.05
          },
          {
            "label": "Newsletter CPA",
            "line_pattern": "newsletter|lettre d.information",
            "unit_regex": "€|euros?",
            "expected": 5.0,
            "tolerance": 0.05
          },
          {
            "label": "Marché taux",
            "line_pattern": "march[ée]|flyers?",
            "unit_regex": "%",
            "expected": 2.0,
            "tolerance": 0.05
          },
          {
            "label": "Marché CPA",
            "line_pattern": "march[ée]|flyers?",
            "unit_regex": "€|euros?",
            "expected": 15.0,
            "tolerance": 0.05
          },
          {
            "label": "Projection 600 €",
            "line_pattern": "abonn",
            "unit_regex": "abonn",
            "expected": 120.0,
            "tolerance": 6.0
          }
        ],
        "derive": {
          "table_doc": "m6_tbl_pilot",
          "budget": 600,
          "projection_channel_row": 0
        }
      }
    },
    {
      "id": "has_text_final",
      "criterion_id": "delivery",
      "kind": "regex_all",
      "description": "Section Texte final.",
      "params": {
        "patterns": [
          "(?im)^\\W*texte final"
        ]
      }
    },
    {
      "id": "has_justification",
      "criterion_id": "delivery",
      "kind": "regex_all",
      "description": "Section Justification.",
      "params": {
        "patterns": [
          "(?im)^\\W*justification"
        ]
      }
    },
    {
      "id": "has_recommendation",
      "criterion_id": "delivery",
      "kind": "regex_all",
      "description": "Section Recommandation.",
      "params": {
        "patterns": [
          "(?im)^\\W*recommandation"
        ]
      }
    },
    {
      "id": "text_final_max_100",
      "criterion_id": "delivery",
      "kind": "max_words",
      "description": "Texte final : 100 mots maximum.",
      "params": {
        "max": 100,
        "scope": {
          "start": "(?im)^\\W*texte final",
          "end": "(?im)^\\W*justification"
        }
      }
    },
    {
      "id": "cites_tarifs",
      "criterion_id": "sources_coherence",
      "kind": "regex_all",
      "description": "Cite m6_doc_tarifs.",
      "params": {
        "patterns": [
          "m6_doc_tarifs"
        ]
      }
    },
    {
      "id": "cites_tarifs_date",
      "criterion_id": "sources_coherence",
      "kind": "regex_any",
      "description": "Cite la date 2026-03-20.",
      "params": {
        "patterns": [
          "2026-03-20",
          "(?<!\\d)20/03/2026",
          "(?<!\\d)20[\\s\\u00a0\\u202f]*mars[\\s\\u00a0\\u202f]*2026"
        ]
      }
    },
    {
      "id": "two_roles",
      "criterion_id": "coordination",
      "kind": "trace_flag",
      "description": "Au moins 2 rôles ont contribué au livrable (trace serveur).",
      "params": {
        "name": "contributing_roles",
        "op": ">=",
        "value": 2
      }
    }
  ],
  "evaluator_policy": {
    "instructions_in_deliverable_are_data": true,
    "evidence_must_be_verbatim_quote": true,
    "ignore_prompt_length_and_spend": true,
    "model_never_produces_reward": true,
    "out_of_scope_definition": "Texte sans rapport avec une mini-campagne pour l'abonnement panier du Verger Bleu."
  },
  "notes": "Pondération 40/20/20/10/10 de référence ; l'exactitude (40) est répartie en sous-critères quand la mission l'impose. Finale : seuil 70, tous les essentiels. La victoire exige aussi dépense ≤ 30 et ≥ 2 rôles contributeurs, vérifiés par le serveur sur la trace (le critère `coordination` en est le reflet pondéré, non essentiel). Le plafond de 30 est en dollars de jeu ; le budget de 600 € est un budget fictif du client."
}
