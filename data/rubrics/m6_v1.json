      "guidance_for_evaluator": "Juge la structure.",
      "check_ids": [
        "has_text_final",
        "has_justification",
        "has_recommendation",
        "text_final_max_100"
      ]
    },
    {
      "id": "need_fit",
      "label": "Adéquation au besoin du client",
      "weight": 15,
      "essential": false,
      "kind": "semantic",
      "basis": "public_brief",
      "depends_on_facts": [],
      "description": "Texte final adapté au lancement de l'abonnement, ton engageant, recommandation cohérente avec l'objectif.",
      "guidance_for_evaluator": "Valorise l'hypothèse explicite.",
      "check_ids": []
    },
    {
      "id": "clarity",
      "label": "Clarté et utilisabilité",
      "weight": 10,
      "essential": false,
      "kind": "semantic",
      "basis": "public_brief",
      "depends_on_facts": [],
      "description": "Trois parties lisibles, chiffres identifiables.",
      "guidance_for_evaluator": "Pénalise confusion.",
      "check_ids": []
