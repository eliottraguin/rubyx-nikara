    {
      "id": "sources_coherence",
      "label": "Sources et cohérence",
      "weight": 10,
      "essential": false,
      "kind": "mixed",
      "basis": "corpus",
      "depends_on_facts": [],
      "description": "Documents cités par identifiant et date ; source applicable identifiée ; cohérence interne.",
      "guidance_for_evaluator": "Vérifie que chaque fait chiffré est rattaché à un document.",
      "check_ids": [
        "cites_tarifs",
        "cites_tarifs_date"
      ]
    },
    {
      "id": "coordination",
      "label": "Coordination observable",
      "weight": 10,
      "essential": false,
      "kind": "deterministic",
      "basis": "trace",
      "depends_on_facts": [],
      "description": "Au moins deux rôles distincts ont produit une contribution liée au livrable (trace serveur).",
      "guidance_for_evaluator": "Reçois la trace comme donnée ; ne la devine pas depuis le texte.",
