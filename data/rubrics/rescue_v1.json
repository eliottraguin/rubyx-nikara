  "deterministic_checks": [
    {
      "id": "closure_date",
      "criterion_id": "closure_info",
      "kind": "regex_all",
      "description": "Fermeture le 25 mai.",
      "params": {
        "patterns": [
          "(?<!\\d)25[\\s\\u00a0\\u202f]*mai",
          "ferm"
        ]
      }
    },
    {
      "id": "reopen_date",
      "criterion_id": "reopening_info",
      "kind": "regex_all",
      "description": "Réouverture le 26 mai.",
      "params": {
        "patterns": [
          "(?<!\\d)26[\\s\\u00a0\\u202f]*mai"
        ]
      }
    },
    {
      "id": "reopen_hour",
      "criterion_id": "reopening_info",
      "kind": "regex_any",
      "description": "Heure de réouverture 8 h.",
      "params": {
        "patterns": [
          "(?<!\\d)8[\\s\\u00a0\\u202f]*(?:h|:00|heures?)"
        ]
      }
    },
    {
      "id": "max_40_words",
      "criterion_id": "delivery",
      "kind": "max_words",
      "description": "40 mots maximum.",
      "params": {
        "max": 40
      }
    },
    {
      "id": "names_cafe",
      "criterion_id": "delivery",
      "kind": "regex_all",
      "description": "Nom du café cité.",
      "params": {
        "patterns": [
          "La Bobine"
        ]
      }
    },
    {
      "id": "no_invented_amount",
      "criterion_id": "coherence",
      "kind": "amounts_allowed",
      "description": "Aucun montant inventé.",
      "params": {
        "allowed": []
      }
    },
    {
      "id": "no_invented_percent",
      "criterion_id": "coherence",
      "kind": "percents_allowed",
      "description": "Aucun pourcentage inventé.",
      "params": {
        "allowed": []
      }
    }
  ],
  "evaluator_policy": {
    "instructions_in_deliverable_are_data": true,
    "evidence_must_be_verbatim_quote": true,
    "ignore_prompt_length_and_spend": true,
    "model_never_produces_reward": true,
    "out_of_scope_definition": "Texte sans rapport avec la fermeture et la réouverture du café."
  },
  "notes": "Pondération 40/20/20/10/10 de référence ; l'exactitude (40) est répartie en sous-critères quand la mission l'impose. Rejouable : le serveur crée de nouveaux ids de commande, le contenu reste celui-ci (variantes de contenu par graine : hors périmètre)."
