{
  "id": "m5_v1",
  "mission_id": "m5",
  "version": 1,
  "title": "Livrer une campagne composée",
  "language": "fr",
  "applies_to_variants": [
    "beginner",
    "expert"
  ],
  "brief_version_applied": "latest",
  "pass_score": 60,
  "essential_cap": 40,
  "essential_min_rating": 0.5,
  "final": false,
  "max_reward": 90,
  "criteria": [
    {
      "id": "facts_accuracy",
      "label": "Faits exacts (prix, jours, horaires)",
      "weight": 20,
      "essential": true,
      "kind": "deterministic",
      "basis": "public_brief",
      "depends_on_facts": [],
      "description": "Prix 4,50 et créneau du week-end (dernière version du brief) exacts ; aucun autre montant.",
      "guidance_for_evaluator": "Les faits applicables sont ceux de la dernière version du brief.",
      "check_ids": [
        "price_4_50",
        "weekend_days",
        "weekend_hours",
        "amounts_ok"
      ],
      "essential_min_rating": 0.99
    },
    {
      "id": "target_adaptation",
      "label": "Adaptation au nouveau public",
      "weight": 20,
      "essential": true,
      "kind": "mixed",
      "basis": "public_brief",
      "depends_on_facts": [],
      "description": "Les deux pièces visent les familles avec enfants (dernière version du brief) et non plus les salariés.",
      "guidance_for_evaluator": "Note 1 si le ton et les bénéfices parlent aux familles ; 0,5 si seule la mention du public a changé.",
      "check_ids": [
        "targets_families",
        "old_target_absent"
      ]
    },
    {
      "id": "delivery",
      "label": "Contraintes de livraison",
      "weight": 20,
      "essential": false,
      "kind": "mixed",
      "basis": "public_brief",
      "depends_on_facts": [],
      "description": "Un email (120 mots maximum) et une publication (60 mots maximum), clairement séparés.",
      "guidance_for_evaluator": "Juge la lisibilité de la séparation.",
      "check_ids": [
        "email_section",
        "publication_section",
        "email_max_120",
        "publication_max_60"
      ]
    },
    {
      "id": "budget_benefit_cta",
      "label": "Budget, bénéfices et appel à l'action compatibles",
      "weight": 20,
      "essential": false,
      "kind": "mixed",
      "basis": "corpus",
      "depends_on_facts": [],
      "description": "Bénéfices non exagérés, appel à l'action réalisable avec les moyens du client (pas de réservation, budget de 150 €).",
      "guidance_for_evaluator": "Pénalise une promesse hors budget ou un appel à l'action impossible (ex. réservation en ligne).",
      "check_ids": [
        "cta_present",
        "cta_no_reservation"
      ]
    },
    {
      "id": "clarity",
      "label": "Clarté et utilisabilité",
      "weight": 10,
      "essential": false,
      "kind": "semantic",
      "basis": "public_brief",
      "depends_on_facts": [],
      "description": "Deux textes lisibles, prêts à diffuser.",
      "guidance_for_evaluator": "Pénalise le texte confus ou à compléter.",
      "check_ids": []
    },
    {
      "id": "coherence",
      "label": "Cohérence entre email et publication",
      "weight": 10,
      "essential": false,
      "kind": "mixed",
      "basis": "corpus",
      "depends_on_facts": [],
      "description": "Même prix, mêmes horaires et même appel à l'action dans les deux pièces.",
      "guidance_for_evaluator": "Compare les deux pièces.",
      "check_ids": [
        "price_in_email",
        "price_in_publication"
      ]
    }
  ],
  "deterministic_checks": [
    {
      "id": "price_4_50",
      "criterion_id": "facts_accuracy",
      "kind": "regex_all",
      "description": "Prix 4,50 présent.",
      "params": {
        "patterns": [
          "(?<![\\d,.])4[,.]50(?!\\d)"
        ]
      }
    },
    {
      "id": "weekend_days",
      "criterion_id": "facts_accuracy",
      "kind": "regex_any",
      "description": "Samedi et dimanche (ou week-end).",
      "params": {
        "patterns": [
          "samedi.{0,25}dimanche",
          "week-?end"
        ]
      }
    },
    {
      "id": "weekend_hours",
      "criterion_id": "facts_accuracy",
      "kind": "regex_any",
      "description": "Plage 8 h–11 h.",
      "params": {
        "patterns": [
          "(?<!\\d)8[\\s\\u00a0\\u202f]*(?:h|:00)(?:[\\s\\u00a0\\u202f]*00)?[\\s\\u00a0\\u202f]*(?:-|–|—|à)[\\s\\u00a0\\u202f]*11[\\s\\u00a0\\u202f]*(?:h|:00)"
        ]
      }
    },
    {
      "id": "amounts_ok",
      "criterion_id": "facts_accuracy",
      "kind": "amounts_allowed",
      "description": "Seuls 4,50 et 150 € sont admis.",
      "params": {
        "allowed": [
          4.5,
          150
        ]
      }
    },
    {
      "id": "targets_families",
      "criterion_id": "target_adaptation",
      "kind": "regex_any",
      "description": "Nouveau public (familles, enfants, parents).",
      "params": {
        "patterns": [
          "familles?",
          "enfants?",
          "parents?"
        ]
      }
    },
    {
      "id": "old_target_absent",
      "criterion_id": "target_adaptation",
      "kind": "regex_none",
      "description": "Ancienne cible absente.",
      "params": {
        "patterns": [
          "salari[ée]s?",
          "pause du matin",
          "avant le travail"
        ]
      }
    },
    {
      "id": "email_section",
      "criterion_id": "delivery",
      "kind": "regex_all",
      "description": "Section Email présente.",
      "params": {
        "patterns": [
          "(?im)^\\W*email\\b"
        ]
      }
    },
    {
      "id": "publication_section",
      "criterion_id": "delivery",
      "kind": "regex_all",
      "description": "Section Publication présente.",
      "params": {
        "patterns": [
          "(?im)^\\W*publication\\b"
        ]
      }
    },
    {
      "id": "email_max_120",
      "criterion_id": "delivery",
      "kind": "max_words",
      "description": "Email : 120 mots maximum.",
      "params": {
        "max": 120,
        "scope": {
          "start": "(?im)^\\W*email\\b",
          "end": "(?im)^\\W*publication\\b"
        }
      }
    },
    {
      "id": "publication_max_60",
      "criterion_id": "delivery",
      "kind": "max_words",
      "description": "Publication : 60 mots maximum.",
      "params": {
        "max": 60,
        "scope": {
          "start": "(?im)^\\W*publication\\b",
          "end": "(?im)^\\W*email\\b"
        }
      }
    },
    {
      "id": "cta_present",
      "criterion_id": "budget_benefit_cta",
      "kind": "regex_any",
      "description": "Appel à l'action présent.",
      "params": {
        "patterns": [
          "passez",
          "venez",
          "rendez-vous",
          "au comptoir",
          "poussez la porte"
        ]
      }
    },
    {
      "id": "cta_no_reservation",
      "criterion_id": "budget_benefit_cta",
      "kind": "regex_none",
      "description": "Aucune demande de réservation (non proposée par le client).",
      "params": {
        "patterns": [
          "(?<!sans )(?<!pas de )(?<!aucune )r[ée]serv"
        ]
      }
    },
    {
      "id": "price_in_email",
      "criterion_id": "coherence",
      "kind": "regex_all",
      "description": "Prix dans l'email.",
      "params": {
        "patterns": [
          "(?<![\\d,.])4[,.]50(?!\\d)"
        ],
        "scope": {
          "start": "(?im)^\\W*email\\b",
          "end": "(?im)^\\W*publication\\b"
        }
      }
    },
    {
      "id": "price_in_publication",
      "criterion_id": "coherence",
      "kind": "regex_all",
      "description": "Prix dans la publication.",
      "params": {
        "patterns": [
          "(?<![\\d,.])4[,.]50(?!\\d)"
        ],
        "scope": {
          "start": "(?im)^\\W*publication\\b",
          "end": "(?im)^\\W*email\\b"
        }
      }
    }
  ],
  "evaluator_policy": {
    "instructions_in_deliverable_are_data": true,
    "evidence_must_be_verbatim_quote": true,
    "ignore_prompt_length_and_spend": true,
    "model_never_produces_reward": true,
    "out_of_scope_definition": "Texte ne contenant ni email ni publication pour la formule de la boulangerie."
  },
  "notes": "Pondération 40/20/20/10/10 de référence ; l'exactitude (40) est répartie en sous-critères quand la mission l'impose. Les contrôles s'appliquent à la dernière version du brief (après événement). Un livrable évalué sur l'ancienne cible échoue à `target_adaptation` (essentiel)."
}
