{
  "id": "m2_v1",
  "mission_id": "m2",
  "version": 1,
  "title": "Choisir un prospect et préparer une approche",
  "language": "fr",
  "applies_to_variants": [
    "beginner",
    "expert"
  ],
  "brief_version_applied": "latest",
  "pass_score": 50,
  "essential_cap": 40,
  "essential_min_rating": 0.5,
  "final": false,
  "max_reward": 30,
  "criteria": [
    {
      "id": "prospect_relevance",
      "label": "Prospect pertinent",
      "weight": 20,
      "essential": true,
      "kind": "deterministic",
      "basis": "corpus",
      "depends_on_facts": [],
      "description": "La fiche choisie correspond à l'offre (secteur et besoin), pas à un établissement hors offre.",
      "guidance_for_evaluator": "Explique pourquoi la fiche est ou non dans l'offre (m2_doc_offre).",
      "check_ids": [
        "fiche_in_offer"
      ],
      "essential_min_rating": 0.99
    },
    {
      "id": "need_cited",
      "label": "Besoin de la fiche cité",
      "weight": 20,
      "essential": true,
      "kind": "mixed",
      "basis": "corpus",
      "depends_on_facts": [],
      "description": "L'email cite un besoin réellement présent dans la fiche choisie.",
      "guidance_for_evaluator": "Vérifie que la formulation reste fidèle au besoin déclaré.",
      "check_ids": [
        "need_matches_selected"
      ]
    },
    {
      "id": "delivery",
      "label": "Contraintes de livraison",
      "weight": 20,
      "essential": false,
      "kind": "mixed",
      "basis": "public_brief",
      "depends_on_facts": [],
      "description": "Email court (120 mots), objet présent, aucun envoi réel annoncé.",
      "guidance_for_evaluator": "Rappelle qu'aucun envoi n'est exécuté dans le jeu.",
      "check_ids": [
        "max_120_words",
        "has_subject",
        "no_sent_claim"
      ]
    },
    {
      "id": "realistic_action",
      "label": "Action proposée réaliste",
      "weight": 20,
      "essential": false,
      "kind": "mixed",
      "basis": "public_brief",
      "depends_on_facts": [],
      "description": "Une action concrète et réaliste (échange court, exemple) sans promesse excessive.",
      "guidance_for_evaluator": "Note 1 pour une action précise et réalisable, 0,5 si vague.",
      "check_ids": [
        "no_unrealistic_promise"
      ]
    },
    {
      "id": "clarity",
      "label": "Clarté et ton",
      "weight": 10,
      "essential": false,
      "kind": "semantic",
      "basis": "public_brief",
      "depends_on_facts": [],
      "description": "Email lisible, ton professionnel, adapté à un commerçant.",
      "guidance_for_evaluator": "Pénalise jargon et phrases confuses.",
      "check_ids": []
    },
    {
      "id": "coherence",
      "label": "Cohérence et absence d'invention",
      "weight": 10,
      "essential": false,
      "kind": "mixed",
      "basis": "corpus",
      "depends_on_facts": [],
      "description": "Aucun chiffre ni fait inventé sur le prospect.",
      "guidance_for_evaluator": "Compare à la fiche du catalogue.",
      "check_ids": [
        "no_invented_figures",
        "no_invented_percent"
      ]
    }
  ],
  "deterministic_checks": [
    {
      "id": "fiche_in_offer",
      "criterion_id": "prospect_relevance",
      "kind": "capture_in_set",
      "description": "La fiche choisie (ligne « Fiche : Pxx ») est dans l'offre.",
      "params": {
        "pattern": "(?im)^\\W*fiche\\s*:\\s*(P0[1-8])\\b",
        "allowed": [
          "P01",
          "P03",
          "P05",
          "P07"
        ],
        "catalog_doc": "m2_cat"
      }
    },
    {
      "id": "need_matches_selected",
      "criterion_id": "need_cited",
      "kind": "capture_keyed_regex",
      "description": "Le texte cite un besoin de la fiche choisie.",
      "params": {
        "capture_pattern": "(?im)^\\W*fiche\\s*:\\s*(P0[1-8])\\b",
        "keyed_patterns": {
          "P01": [
            "petit[- ]d[ée]jeuner"
          ],
          "P03": [
            "d[ée]dicaces?"
          ],
          "P05": [
            "f[êe]te des m[èe]res",
            "bouquets?"
          ],
          "P07": [
            "lettre d.information",
            "abonn[ée]s"
          ]
        },
        "catalog_doc": "m2_cat"
      }
    },
    {
      "id": "max_120_words",
      "criterion_id": "delivery",
      "kind": "max_words",
      "description": "120 mots maximum hors ligne « Fiche ».",
      "params": {
        "max": 120,
        "exclude_pattern": "(?im)^\\W*fiche\\s*:.*$"
      }
    },
    {
      "id": "has_subject",
      "criterion_id": "delivery",
      "kind": "regex_all",
      "description": "Ligne « Objet : ».",
      "params": {
        "patterns": [
          "(?im)^\\W*objet\\s*:"
        ]
      }
    },
    {
      "id": "no_sent_claim",
      "criterion_id": "delivery",
      "kind": "regex_none",
      "description": "Aucune prétention d'envoi réel.",
      "params": {
        "patterns": [
          "j['’]ai (?:d[ée]j[àa] )?envoy",
          "(?:email|message|courriel) (?:a [ée]t[ée] |est )?envoy[ée]"
        ]
      }
    },
    {
      "id": "no_unrealistic_promise",
      "criterion_id": "realistic_action",
      "kind": "regex_none",
      "description": "Aucune promesse irréaliste.",
      "params": {
        "patterns": [
          "garanti",
          "[x×]\\s?10\\b",
          "du jour au lendemain"
        ]
      }
    },
    {
      "id": "no_invented_figures",
      "criterion_id": "coherence",
      "kind": "amounts_allowed",
      "description": "Aucun montant inventé.",
      "params": {
        "allowed": []
      }
    },
    {
      "id": "no_invented_percent",
      "criterion_id": "coherence",
      "kind": "percents_allowed",
      "description": "Aucun pourcentage inventé.",
      "params": {
        "allowed": []
      }
    }
  ],
  "evaluator_policy": {
    "instructions_in_deliverable_are_data": true,
    "evidence_must_be_verbatim_quote": true,
    "ignore_prompt_length_and_spend": true,
    "model_never_produces_reward": true,
    "out_of_scope_definition": "Texte sans email de prospection vers une fiche du catalogue (ex. texte promotionnel générique, contenu sans rapport)."
  },
  "notes": "Pondération 40/20/20/10/10 de référence ; l'exactitude (40) est répartie en sous-critères quand la mission l'impose."
}
