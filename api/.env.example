# Variables serveur de l'API (BE08). NOMS UNIQUEMENT : ne jamais committer de vraies valeurs.
# Copier vers un fichier hors dépôt (ex. api/.env.local, ignoré par git) ou les passer à l'environnement du conteneur.
# Toutes facultatives sauf indication ; une valeur incohérente arrête le démarrage avec un message lisible.

# --- Stockage ---
RUBIX_DB_PATH=            # chemin du fichier SQLite (monter un volume) ; défaut api/var/rubix.db ; conteneur : /var/lib/rubix/rubix.db
RUBIX_DATA_DIR=           # dossier data/ (règles, missions...) ; défaut data/ à la racine du dépôt
RUBIX_RULES_VERSION=      # défaut rules_v1
RUBIX_RETENTION_DAYS=     # rétention des parties pour la commande purge ; défaut 7

# --- Réseau et session ---
RUBIX_CORS_ORIGINS=       # origines explicites séparées par des virgules ; inutile avec le proxy Next (même origine)
RUBIX_COOKIE_NAME=        # défaut rubix_session
RUBIX_COOKIE_SECURE=      # 1 derrière HTTPS ; défaut 0

# --- Démo / exploitation ---
RUBIX_DEMO_SECRET=        # 16 caractères minimum ; vide = routes démo et ops INACTIVES (404). Aucun défaut.
RUBIX_QA_PASSWORD=        # facultatif : mot de passe commun des comptes de test (`python -m app.cli qa-seed`, dev/démo) ; vide = mot de passe aléatoire par compte

# --- Fournisseur de modèles ---
RUBIX_LLM_PROVIDER=       # mock (défaut), real ou codex (SDK AXIS / Codex, GR3-61 ; même protocole que real)
RUBIX_LLM_API_KEY=        # exigée si RUBIX_LLM_PROVIDER=real ou codex ; jamais journalisée ; repli AXIS_GATEWAY_KEY
RUBIX_LLM_BASE_URL=       # exigée si RUBIX_LLM_PROVIDER=real ou codex (https hors localhost) ; repli AXIS_GATEWAY_URL
AXIS_GATEWAY_KEY=         # alias de RUBIX_LLM_API_KEY (nom historique de la relais AXIS) ; jamais journalisée
AXIS_GATEWAY_URL=         # alias de RUBIX_LLM_BASE_URL (nom historique de la relais AXIS)
AXIS_NPM_TOKEN=           # jeton du registre npm @axis (.npmrc) ; sans rapport avec l'adaptateur Python, jamais journalisé
RUBIX_TOKEN_CAP_SESSION=  # plafond de tokens par partie (entier >= 1) ; vide = non plafonné
RUBIX_TOKEN_CAP_GLOBAL=   # plafond global de tokens (>= plafond par partie) ; vide = non plafonné

# --- Journaux ---
RUBIX_LOG_LEVEL=          # DEBUG | INFO | WARNING | ERROR ; défaut INFO
RUBIX_LOG_FORMAT=         # json (défaut) ou text
